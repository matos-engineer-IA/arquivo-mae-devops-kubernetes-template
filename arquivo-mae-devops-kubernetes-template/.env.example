# Copie para .env somente no ambiente local.
# Nunca insira valores reais neste arquivo versionado.

APP_ENV=local
APP_PORT=0000
APP_BASE_URL=http://localhost:0000

DATABASE_URL=replace-with-local-or-secret-managed-value
DATABASE_USER=replace-me
DATABASE_PASSWORD=replace-me

EXTERNAL_API_BASE_URL=https://api.example.invalid
EXTERNAL_API_TOKEN=replace-me

LOG_LEVEL=info
FEATURE_EXAMPLE_ENABLED=false

# Drone CLI — valores reais devem vir do cofre ou sessão segura.
DRONE_SERVER=https://drone.example.invalid
DRONE_TOKEN=replace-me
DRONE_REPO=owner/repository
ALLOW_DRONE_WRITE=0

# Rancher CLI — uso de bootstrap/operação humana.
RANCHER_URL=https://rancher.example.invalid
RANCHER_TOKEN=replace-me

# Kubernetes — kubeconfig deve ficar fora do repositório.
KUBECONFIG=/secure/path/kubeconfig.yaml
KUBE_CONTEXT=replace-me
EXPECTED_KUBE_CONTEXT=replace-me
EXPECTED_KUBE_SERVER=https://kubernetes-api.example.invalid
KUBE_NAMESPACE=app-template-development
EXPECTED_KUBE_NAMESPACE=app-template-development
K8S_OVERLAY=devops/kubernetes/overlays/development
K8S_DEPLOYMENT=app-template
K8S_IMAGE_PLACEHOLDER=registry.example.invalid/team/app-template:replace-me
IMAGE=registry.example.invalid/team/app-template:commit-sha
ROLLOUT_TIMEOUT=180s

# Gates adicionais; padrão é não escrever.
ALLOW_CLUSTER_WRITE=0
ALLOW_PRODUCTION_DEPLOY=0
CHANGE_TICKET=
DRY_RUN_ONLY=1
CHECK_SERVER=0
